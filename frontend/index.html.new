function openEntity(id){
  navigate('entity');
  const headerEl=document.getElementById('entityHeader');
  if(headerEl) headerEl.innerHTML=`Loading ${id}…`;
  api('/why/'+id).then(w=>{
    const lead=w.lead;
    const bodyEl=document.getElementById('entityBody');
    if(!bodyEl) return;
    bodyEl.innerHTML=`<div class="card" style="border-left:4px solid var(--gold)"><h3>${w.id} — ${w.label} ${pill(w.cell)} <span style="font-size:11px;color:var(--muted)">${w.role}</span> <span style="float:right" class="pill pill-${lead?.priority||'LOW'}">${lead?.lead_score||'—'}/100 ${lead?.priority||''}</span></h3><div style="font-size:13px;margin-top:8px"><b>Why was ${w.id} flagged?</b><br>${w.top_signals.slice(0,3).map(s=>`• ${s.slice(0,120)}`).join('<br>')}<br><span class="muted">What does this mean? — Several small signals together make this worth checking.</span></div><details style="margin-top:8px"><summary style="font-size:11px;color:var(--muted)">Technical Analysis ▾</summary><div class="mono" style="font-size:11px">${lead? Object.entries(lead.signals).map(([k,v])=>`${k}: ${v}`).join('<br>'):''}</div></details></div><div class="card"><h3>Evidence — you can verify</h3>${w.sources.slice(0,3).map(s=>`<div style="padding:6px 0;border-bottom:1px solid var(--border);font-size:11px"><b>${s.source}</b> Day ${s.day||'—'}<br><span class="muted">${(s.supporting_text||'').slice(0,100)}</span></div>`).join('')}</div>`;
    if(headerEl) headerEl.innerHTML=`<div class="card"><b>${w.id}</b> ${w.label} — Priority ${lead?.priority||''} ${lead?.lead_score||''}/100</div>`;
  });
}
function showMapping(iid){_pendingInv=iid;navigate('mapping'); api(`/investigations/${iid}/files`).then(d=>{let html=''; d.files.forEach(async f=>{const det=await api(`/investigations/${iid}/detection/${encodeURIComponent(f.original)}`); html+=`<div class="card"><h3>${f.original} — ${det.detection.detected_type}</h3><div style="font-size:11px">${Object.entries(det.suggested_mapping).slice(0,5).map(([k,v])=>`${k} → ${v||'Missing'}`).join('<br>')}</div></div>`; document.getElementById('mappingBox').innerHTML=html;})}
let _pendingInv=null;
document.addEventListener('DOMContentLoaded',()=>{const v=location.hash.slice(1)||'dashboard';navigate(v);});
</script>
</body>
</html>
