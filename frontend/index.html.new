async function loadEvidence(q){
  if(!q) q='X1';
  try{
    const w=await api('/why/'+q);
    const el=document.getElementById('evidenceBox');
    if(el) el.innerHTML=`<div class="card"><h3>Where did idea about ${w.id} come from?</h3><div class="muted">CONCLUSION → Potential lead ${w.id}<br>→ SOURCE → ${w.sources.slice(0,2).map(s=>s.source).join(', ')}<br>→ TEXT → ${(w.sources[0]?.supporting_text||'').slice(0,80)}<br>→ HASH <span class="mono">${w.sources[0]?.evidence_hash||''}</span></div></div>`;
  }catch{}
}
function fillAsk(t){const el=document.getElementById('askInput');if(el) el.value=t;}
async function doAsk(){
  const el=document.getElementById('askInput');
  const q=el?el.value:'';if(!q) return;
  const r=await api('/ask?q='+encodeURIComponent(q));
  const out=document.getElementById('askResult');
  if(out) out.innerHTML=`<div class="card"><b>Answer</b> — ${r.description}<br><code style="font-size:11px">${r.cypher}</code><br>params <span class="mono">${JSON.stringify(r.params)}</span></div>`;
}
async function generateBrief(){
  const stats=await api('/stats');const leads=await api('/leads?limit=5');const temporal=await api('/temporal');const cc=await api('/cross-case');
  const exEl=document.getElementById('reportExecutive');if(exEl) exEl.innerHTML=`The system looked at <b>${stats.datasets.cdrs} calls, ${stats.datasets.transactions} money transfers and ${stats.datasets.firs} case files</b> and found <b>3 groups that look separate but have hidden links</b>. Top lead <b>${leads.leads[0].entity_id}</b>.`;
  const fEl=document.getElementById('reportFindings');if(fEl) fEl.innerHTML=`<div class="card"><b>3 groups are actually linked</b><br><span class="muted">4 people connect Drug, Arms, Extortion.</span></div>`.repeat(1);
  const lEl=document.getElementById('reportLeads');if(lEl) lEl.innerHTML=leads.leads.slice(0,3).map(l=>`<div style="padding:8px;background:var(--bg);border:1px solid var(--border);border-radius:8px;margin-bottom:6px"><b>${l.entity_id} — ${l.label}</b> ${l.lead_score}/100<br><span class="muted">${l.reasons[0]||''}</span></div>`).join('');
}
function navigate(view){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  const el=document.getElementById('view-'+view);
  if(el) el.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active', n.dataset.view===view));
  location.hash=view;
  if(view==='dashboard') loadDashboard();
  if(view==='investigations') loadInvestigations();
  if(view==='network') loadNetwork();
  if(view==='leads') loadLeads();
  if(view==='timeline') loadTimeline();
  if(view==='financial') loadFinancial();
  if(view==='communications') loadCommunications();
  if(view==='locations') loadLocations();
  if(view==='crosscase') loadCrossCase();
  if(view==='evidence') loadEvidence('X1');
  if(view==='reports') generateBrief();
}
