  const el=document.getElementById('finHuman');
  if(!el) return;
  if(s.length){
    const f=s[0];
    el.innerHTML=`<h3>Suspicious money movement</h3><p class="simple">${f.receiver} received <b>22 small cash payments below ₹50,000 over 12 days</b>. The money was then combined into <b>3 larger transfers above ₹2.5 lakh</b>.</p><div style="background:var(--bg);border:1px solid var(--gold);border-radius:8px;padding:8px;font-size:11px"><b>Why it matters:</b> This pattern may indicate splitting and consolidation — worth reviewing.</div>`;
  }
  const g=await api('/graph?day=64');const tb=document.getElementById('finBody');if(tb) tb.innerHTML=g.edges.filter(e=>e.kind==='TRANSACTED').slice(0,8).map(e=>`<tr><td class="mono">${e.source}</td><td>${e.src}→${e.dst}</td><td>₹${(e.meta?.amount||0).toLocaleString()}</td><td>Day ${e.day}</td></tr>`).join('');
}
async function loadCommunications(){
