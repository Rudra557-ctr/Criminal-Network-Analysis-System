  const el=document.getElementById('commHuman');
  if(el) el.innerHTML=`<p class="simple">Calls increased sharply on Days ${bursts.slice(0,2).map(b=>b.day).join(', ')} compared with the previous week.</p>`;
  const g=await api('/graph?day=58');const tb=document.getElementById('commBody');if(tb) tb.innerHTML=g.edges.filter(e=>e.kind==='CALLED').slice(0,8).map(e=>`<tr><td class="mono">${e.source}</td><td>${e.src}→${e.dst}</td><td>Day ${e.day}</td><td>${e.meta?.tower||''}</td></tr>`).join('');
}
